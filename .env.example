# Copy to `.env` and fill in. Never commit `.env`.

# --- Database (PostgreSQL, e.g. Neon) ---------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Auth.js ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Web Push (optional; push is disabled when unset) -----------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Cron (practice reminders) ----------------------------------------------
# Required by /api/cron/practice-reminders. The endpoint refuses all requests
# when this is empty. Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- Band settings (all optional) -------------------------------------------
# IANA timezone used for "today" and start-time maths
BAND_TIMEZONE="Europe/Oslo"
# Default rehearsal venue when a form leaves it blank
DEFAULT_VENUE="Demo Studio"
# Venues whose name contains this text (case-insensitive) get the door code
DOOR_CODE_VENUE_MATCH="demo studio"
# Rehearsal-room door code shown for matching venues. Leave empty to disable.
LYDROM_DOOR_CODE=""
