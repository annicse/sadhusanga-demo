// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Auth.js (NextAuth) Models
// -----------------------------------------------------------------------------

enum Role {
  user
  admin
}

model User {
  id            String    @id @default(cuid())
  name          String? // maps to display_name
  email         String?   @unique
  password      String? // Hashed password for credentials provider
  emailVerified DateTime?
  image         String?
  instrument    String?
  role          Role      @default(user)
  accounts      Account[]
  sessions      Session[]

  // App Relationships
  songsCreated    Song[]    @relation("SongCreator")
  setlistsCreated Setlist[] @relation("SetlistCreator")
  practicesCreated Practice[] @relation("PracticeCreator")
  practiceRsvps   PracticeRsvp[] @relation("UserPracticeRsvps")
  practiceSuggestions PracticeSuggestion[] @relation("UserPracticeSuggestions")
  practiceSuggestionVotes PracticeSuggestionVote[] @relation("UserPracticeVotes")

  // Notification Preferences
  notifyPracticeMorning    Boolean @default(true)
  notifyPracticeOneHour    Boolean @default(true)
  notifyPracticeCancel     Boolean @default(true)
  notifyPracticeChange     Boolean @default(true)
  notifyPracticeSuggestion Boolean @default(true)
  notifyPracticeVote       Boolean @default(true)
  notifyPracticeRsvp       Boolean @default(true)

  pushSubscriptions        PushSubscription[] @relation("UserPushSubscriptions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// Sadhusanga Domain Models
// -----------------------------------------------------------------------------

model Song {
  id     String  @id @default(cuid())
  title  String
  artist String?
  key    String?
  tempo  Int?
  notes  String?
  lyrics String? @db.Text
  songlink String?

  createdById String
  createdBy   User   @relation("SongCreator", fields: [createdById], references: [id])

  setlists SetlistSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setlist {
  id         String    @id @default(cuid())
  name       String
  event_date DateTime?
  venue      String?
  comment    String?
  playlist_link String?

  createdById String
  createdBy   User   @relation("SetlistCreator", fields: [createdById], references: [id])

  songs SetlistSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SetlistSong {
  id               String  @id @default(cuid())
  position         Int
  performance_note String?

  setlistId String
  setlist   Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([setlistId, songId])
}

// Tombstones for delta sync: when a Song or Setlist is deleted we record it
// here so clients syncing with `?since=` can remove it from IndexedDB.
model DeletedRecord {
  id        String   @id @default(cuid())
  model     String // "Song" | "Setlist"
  recordId  String
  deletedAt DateTime @default(now())

  @@index([model, deletedAt])
}

// -----------------------------------------------------------------------------
// Practice Rehearsal Models
// -----------------------------------------------------------------------------

enum RsvpStatus {
  GOING
  NOT_GOING
  MAYBE
}

model Practice {
  id           String     @id @default(cuid())
  date         DateTime
  time         String     @default("20:00") // e.g. "20:00" / "8:00 PM"
  venue        String     @default("Kampen")
  notes        String?    @db.Text
  isCancelled  Boolean    @default(false)
  cancelReason String?

  morningReminderSentAt DateTime?
  oneHourReminderSentAt DateTime?

  createdById  String
  createdBy    User       @relation("PracticeCreator", fields: [createdById], references: [id])

  rsvps        PracticeRsvp[]
  suggestions  PracticeSuggestion[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([date])
}

model PracticeRsvp {
  id         String     @id @default(cuid())
  status     RsvpStatus @default(GOING)
  comment    String?

  practiceId String
  practice   Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  userId     String
  user       User       @relation("UserPracticeRsvps", fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([practiceId, userId])
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model PracticeSuggestion {
  id            String           @id @default(cuid())
  proposedDate  DateTime?
  proposedTime  String?
  proposedVenue String?
  reason        String?          @db.Text
  status        SuggestionStatus @default(PENDING)

  practiceId    String
  practice      Practice         @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  createdById   String
  createdBy     User             @relation("UserPracticeSuggestions", fields: [createdById], references: [id])

  votes         PracticeSuggestionVote[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model PracticeSuggestionVote {
  id           String             @id @default(cuid())
  agree        Boolean            // true = Yes, false = No

  suggestionId String
  suggestion   PracticeSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  userId       String
  user         User               @relation("UserPracticeVotes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([suggestionId, userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String

  userId    String
  user      User     @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
